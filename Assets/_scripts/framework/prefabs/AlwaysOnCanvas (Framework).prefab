  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dieses Spiel speichert deinen Fortschritt automatisch, sobald du bestimmte
    Stellen im Spiel erreichst hast. Du brauchst also nicht manuell zu speichern
    - hast dazu aber im Pausemen\xFC die M\xF6glichkeit.\n\nDein Spielstand wird,
    gekoppelt an dein Token, anonym auf unserem Server gespeichert. So kannst du
    mit deinem Token auch auf anderen Ger\xE4ten weiterspielen.\n\nW\xE4hrend dem
    Spielen ben\xF6tigst du durchgehend eine Internetverbindung, da Inhalte wie Videos
    beim Spielen gestreamed werden."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 29bacefaf603deb43b2f16ff3ede2a9e, type: 2}
  m_sharedMaterial: {fileID: -4693097384214812716, guid: 29bacefaf603deb43b2f16ff3ede2a9e, type: 2}
