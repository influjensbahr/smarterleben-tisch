  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dieses Spiel kann deinen Spielstand anonym in der Cloud speichern. So
    kannst du das Spiel auch auf einem anderen Ger\xE4t fortsetzen und verlierst
    deinen Spielstand nicht, wenn du das Spiel neu installierst.\n\nDie Daten werden
    auf einem Server in Deutschland gespeichert und sind nicht f\xFCr Dritte zug\xE4nglich.
    Die gespeicherten Daten k\xF6nnen nur deiner ID, aber nicht dir pers\xF6nlich
    zugeordnet werden.\n\nZur zus\xE4tzlichen Sicherheit kannst du deinen Spielstand
    auch durch ein Passwort verschl\xFCsseln - es gibt dann aber keine M\xF6glichkeit
    der Wiederherstellung, falls du das Passwort vergessen hast."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 29bacefaf603deb43b2f16ff3ede2a9e, type: 2}
  m_sharedMaterial: {fileID: -4693097384214812716, guid: 29bacefaf603deb43b2f16ff3ede2a9e, type: 2}
